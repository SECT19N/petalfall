{
  "name": "petalfall",
  "version": "1.0.0",
  "description": "Customizable falling petals, leaves, snow and emoji for any site. Zero dependencies, with a grab-and-fling interaction.",
  "keywords": [
    "petals",
    "leaves",
    "falling",
    "snow",
    "emoji",
    "particles",
    "animation",
    "sakura"
  ],
  "license": "MIT",
  "author": "SECT19N",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SECT19N/petalfall.git"
  },
  "homepage": "https://sect19n.github.io/petalfall/",
  "bugs": {
    "url": "https://github.com/SECT19N/petalfall/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "eslint": "^10.14.0",
    "react": "^19.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "pnpm@12.16.1"
}
